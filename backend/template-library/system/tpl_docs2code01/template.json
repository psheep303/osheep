    {
      "id": "node_docsplan",
      "blockId": 5,
      "kind": "agent",
      "title": "Claude 文档转方案",
      "providerKind": "claude-cli",
      "model": "default",
      "prompt": "只分析和规划，不修改文件。结合用户任务、抓取到的文档和当前项目实际版本，提炼与实现直接相关的 API、约束、示例和易错点。区分文档明确内容与推断；若网页内容不完整，明确缺口，不要编造。然后给出最小可执行的文件级实现计划、错误处理、测试和兼容性注意事项。\n\n用户输入 JSON：\n{{blocks[2].text}}\n\n网页正文：\n{{blocks[4].text}}",
