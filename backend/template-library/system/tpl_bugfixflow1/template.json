        "retries": 0,
        "retryForever": false,
        "alwaysEnter": false,
        "autoSuccess": true,
        "claudePermissionMode": "acceptEdits",
        "claudeMode": "plan"
      }
    },
    {
      "id": "node_bugrepair",
      "blockId": 5,
      "kind": "agent",
      "title": "Codex 修复验证",
      "providerKind": "codex-cli",
      "model": "default",
      "prompt": "根据已确认的根因实施最小修复。先核对诊断与实际代码；修复根因而不是只掩盖症状。添加能在修复前失败、修复后通过的回归测试，并运行最小相关验证。不要修改无关代码。最后报告根因、改动文件、测试结果和剩余风险。\n\nBug 信息：\n{{blocks[2].text}}\n\nClaude 诊断与方案：\n{{blocks[4].text}}",
