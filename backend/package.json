{
  "name": "osheep-backend",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "repository": "https://github.com/psheep303/osheep",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.11.2",
    "node-pty": "^1.0.0",
    "smol-toml": "^1.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  }
}
