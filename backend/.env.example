# Server
OSHEEP_HOST=127.0.0.1
OSHEEP_PORT=4178
WORKSPACES_ROOT=./workspaces
# Loopback HTTP origins are trusted automatically. Use a comma-separated
# explicit allowlist when OSHEEP_HOST is not loopback.
CORS_ORIGIN=http://127.0.0.1:5173
# Required for non-loopback listening. Generate at least 32 random characters.
# OSHEEP_AUTH_TOKEN=replace-with-a-random-token

# Resource limits
MAX_FILE_SIZE_BYTES=5242880
MAX_TERMINAL_SESSIONS=16
TERMINAL_IDLE_TIMEOUT_MS=0
AGENT_STALL_TIMEOUT_MS=1800000

# Optional local paths
# Use absolute paths for the host platform, for example /home/user/.osheep/templates
# or C:\path\to\templates.
# OSHEEP_TEMPLATES_ROOT=/home/user/.osheep/templates
# OSHEEP_CLAUDE_CONFIG_DIR=/home/user/.claude
# OSHEEP_CODEX_CONFIG_DIR=/home/user/.codex

# Optional skills.sh catalog access. The API docs require a Bearer token for
# authenticated requests; the local npx install flow does not require this.
# SKILLS_SH_API_TOKEN=your-skills-sh-token
# SKILLS_SH_API_URL=https://skills.sh/api/v1/skills
