# Server
OSHEEP_HOST=127.0.0.1
OSHEEP_PORT=4178
WORKSPACES_ROOT=./workspaces
# Loopback HTTP origins are trusted automatically. Use a comma-separated
# explicit allowlist when OSHEEP_HOST is not loopback.
CORS_ORIGIN=http://127.0.0.1:5173
# Required for non-loopback listening. Generate at least 32 random characters.
# OSHEEP_AUTH_TOKEN=replace-with-a-random-token

# Resource limits
MAX_FILE_SIZE_BYTES=5242880
MAX_TERMINAL_SESSIONS=16
TERMINAL_IDLE_TIMEOUT_MS=0
AGENT_STALL_TIMEOUT_MS=1800000

# Optional local paths
# OSHEEP_TEMPLATES_ROOT=C:\path\to\templates
# OSHEEP_CLAUDE_CONFIG_DIR=C:\path\to\claude-config
# OSHEEP_CODEX_CONFIG_DIR=C:\path\to\codex-config
