{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Osheep",
  "version": "0.2.0-alpha.3",
  "identifier": "com.osheep.desktop",
  "build": {
    "beforeDevCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-dev.ps1",
    "beforeBuildCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-release.ps1",
    "frontendDist": "../shell"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "useLocalToolsDir": true,
    "resources": {
      "../stage/node/node.exe": "sidecar/node.exe",
      "../stage/backend/": "backend/",
      "../stage/frontend/": "frontend/"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
