{
  "name": "osheep-frontend",
  "private": true,
  "version": "0.2.0",
  "license": "MIT",
  "repository": "https://github.com/psheep303/osheep",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/compress-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:i18n && npm run test:theme && npm run test:workflow-behavior && npm run test:terminal-conversation && npm run test:api && npm run test:vite-manual-chunks && npm run test:workbench-css-reader && npm run check:agent-navigation && npm run check:workflow-left-sidebar && npm run check:desktop-titlebar && npm run check:start-up-splash && npm run check:workflow-css && npm run check:workbench-css-equivalence",
    "test:i18n": "tsx --test src/i18n/ui-preferences.test.ts",
    "test:workflow-behavior": "tsx --test src/workbench/workflow-behavior.test.ts",
    "test:terminal-conversation": "tsx --test src/workbench/terminal-conversation.test.ts",
    "test:theme": "node --test src/workbench/theme.test.mjs",
    "test:api": "tsx --test src/workbench/api.test.ts",
    "test:vite-manual-chunks": "tsx --test scripts/vite-manual-chunks.test.ts",
    "test:workbench-css-reader": "node --test scripts/read-workbench-css.test.mjs",
    "check:agent-navigation": "node scripts/check-agent-navigation.mjs",
    "check:workflow-left-sidebar": "node scripts/check-workflow-left-sidebar.mjs",
    "check:desktop-titlebar": "node scripts/check-desktop-titlebar.mjs",
    "check:start-up-splash": "node scripts/check-startup-splash.mjs",
    "check:workflow-css": "node scripts/check-workflow-node-css.mjs",
    "check:workbench-css-equivalence": "node scripts/check-workbench-css-equivalence.mjs",
    "update:workbench-css-equivalence": "node scripts/check-workbench-css-equivalence.mjs --update",
    "preview": "vite preview",
    "lint": "biome check src scripts",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@monaco-editor/react": "^4.6.0",
    "@tauri-apps/api": "^2.11.0",
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "marked": "^18.0.7",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  }
}
